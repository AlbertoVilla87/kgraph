# ── Astrolabe environment variables ────────────────────────────────
# Copy to .env and adjust for your deployment.
# The backend reads these at startup; Ollama URL is only needed
# when using citation-guided discovery.
# ───────────────────────────────────────────────────────────────────

# Ollama (citation mode only — ignored if not using --profile citation)
OLLAMA_BASE_URL=http://ollama:11434

# CORS (add your production domain when using a custom hostname)
CORS_ORIGINS=http://localhost,http://localhost:80

# Hugging Face — offline mode (models baked into the image)
HF_HUB_OFFLINE=1

# Nginx port (host-side)
NGINX_PORT=80
